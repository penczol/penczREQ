# Skopiuj ten plik jako .env.container i uzupełnij wartości.
# .env.container jest ignorowany przez Git i nigdy nie trafia do obrazu.

PENCZREQ_IMAGE=ghcr.io/OWNER/penczreq:0.5.2
APP_ENV=production
APP_BASE_URL=https://requests.example.com
CONTROL_BASE_URL=http://192.0.2.10:18001
PUBLIC_ACCESS_MODE=reverse-proxy
CONTROL_ACCESS_MODE=lan
PUBLIC_COOKIE_SECURE=true
CONTROL_COOKIE_SECURE=false

PUBLIC_BIND_IP=127.0.0.1
PUBLIC_PORT=8000
CONTROL_BIND_IP=127.0.0.1
CONTROL_PORT=8001

APP_DATA_PATH=./container-data/app
CONTROL_DATA_PATH=./container-data/control
BACKUP_DATA_PATH=./container-data/backups

ALLOWED_HOSTS=requests.example.com,127.0.0.1,localhost
CONTROL_ALLOWED_HOSTS=control.example.internal,127.0.0.1,localhost
CONTROL_ALLOWED_NETWORKS=127.0.0.0/8,::1/128,10.0.0.0/24
CONTROL_TRUSTED_PROXIES=
PUBLIC_TRUSTED_PROXIES=
# Deployment-only opt-in. Włącz wyłącznie dla kontenerowego reverse proxy.
AUTO_TRUST_RUNTIME_GATEWAY=false
PUBLIC_FORWARDED_ALLOW_IPS=
CONTROL_FORWARDED_ALLOW_IPS=

SESSION_SECRET=
CONTROL_SESSION_SECRET=
CONFIG_ENCRYPTION_KEY=

PUBLIC_ADMIN_USERNAME=admin
PUBLIC_ADMIN_BOOTSTRAP_PASSWORD=
CONTROL_ADMIN_USERNAME=control-admin
CONTROL_BOOTSTRAP_PASSWORD=

# Jednorazowe odzyskiwanie Control. Normalnie oba pola pozostają puste.
CONTROL_RECOVERY_NONCE=
CONTROL_RECOVERY_PASSWORD=

# Może pozostać pusty i zostać ustawiony później w penczREQ Control.
TMDB_TOKEN=
VAPID_SUBJECT=mailto:webpush@example.invalid

SESSION_DAYS=180
SESSION_IDLE_MINUTES=43200
CONTROL_SESSION_HOURS=8
CONTROL_IDLE_MINUTES=20
TMDB_REFRESH_HOURS=6
SECURITY_LOG_RETENTION_DAYS=30
BACKUP_RETENTION_DAYS=30
